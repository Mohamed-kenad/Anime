{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 3007,
      "includeFiles": [
        "public/*",
        "node_modules/@sparticuz/chromium/bin/**",
        "node_modules/@sparticuz/chromium/build/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
